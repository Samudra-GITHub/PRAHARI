# Secrets for docker-compose.yml. Copy to `.env` in this directory and fill in
# every empty value — Compose refuses to start while any is missing.
#
# Generate each secret with:   openssl rand -hex 32
# POSTGRES_PASSWORD is embedded in a connection URL, so keep it URL-safe
# (hex output is ideal). Never commit the real `.env`.

POSTGRES_USER=prahari
POSTGRES_DB=prahari
POSTGRES_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CRON_SECRET=

# Optional overrides
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
# SEED_DEMO_DATA=true
